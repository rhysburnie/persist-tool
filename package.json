{
  "name": "persist-tool",
  "author": "Rhys Burnie",
  "repository": "github:rhysburnie/persist-tool",
  "description": "A Storage wrapper with several utilities",
  "keywords": [
    "Storage",
    "localStorage",
    "sessionStorage"
  ],
  "license": "ISC",
  "version": "1.0.1",
  "main": "dist/persist-tool.umd.js",
  "module": "dist/persist-tool.mjs",
  "exports": {
    ".": {
      "import": "./dist/persist-tool.mjs",
      "require": "./dist/persist-tool.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "bench": "vitest bench",
    "docs": "jsdoc2md --files src/*.js > DOCS.md",
    "lint": "eslint",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "crypto-js": "^4.1.1",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jsdoc-to-markdown": "^8.0.0",
    "prettier": "^3.0.0",
    "vite": "^4.3.9",
    "vitest": "^0.33.0"
  }
}
